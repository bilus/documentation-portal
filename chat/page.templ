package chat

import (
	"strconv"

	"github.com/bilus/live-templ/live"
)

templ chatPage(lv live.Ctx, p *page) {
	<title>Chat</title>
	<style>
		body { margin: 0; font: 15px/1.5 Inter, ui-sans-serif, system-ui, sans-serif; color: #1f2937; }
		.portal-nav { display: flex; gap: 1.25rem; align-items: center; height: 2.5rem; padding: 0 1rem; border-bottom: 1px solid #d8dde6; font: 14px Inter, ui-sans-serif, system-ui, sans-serif; }
		.portal-nav a { color: inherit; text-decoration: none; }
		.portal-nav a.current { font-weight: 600; }
		.portal-menu { margin-left: auto; position: relative; }
		.portal-menu summary { cursor: pointer; }
		.portal-menu-list { position: absolute; right: 0; top: 100%; z-index: 10; display: flex; flex-direction: column; min-width: 12rem; margin-top: .5rem; padding: .25rem 0; background: #fff; border: 1px solid #d8dde6; border-radius: 4px; }
		.portal-menu-list a { padding: .375rem 1rem; }
		.portal-menu-list a:hover { background: #f1f3f6; }
		.chat { max-width: 760px; margin: 0 auto; padding: 1.5rem 1rem 3rem; }
		.chat h1 { font-size: 1.4rem; margin: 0 0 0.25rem; }
		.note { margin: 0 0 1.25rem; color: #6b7280; font-size: 0.9rem; }
		.messages { list-style: none; margin: 0; padding: 0; }
		.message { margin: 0 0 1rem; padding: 0.75rem 1rem; border-radius: 8px; background: #f3f4f6; overflow-x: auto; }
		.message.mine { background: #e0e7ff; margin-left: 3rem; }
		.message.error { background: #fef2f2; color: #991b1b; }
		.message p:first-child { margin-top: 0; }
		.message p:last-child { margin-bottom: 0; }
		.message pre { background: #111827; color: #f9fafb; padding: 0.75rem; border-radius: 6px; overflow-x: auto; }
		.ask { display: flex; gap: 0.5rem; align-items: flex-end; }
		.ask textarea { flex: 1; font: inherit; padding: 0.5rem; border: 1px solid #d1d5db; border-radius: 6px; }
		.ask button { font: inherit; padding: 0.5rem 1rem; border: 0; border-radius: 6px; background: #111827; color: #fff; cursor: pointer; }
		.thinking { display: none; color: #6b7280; margin: 0 0 1rem; }
		.phx-submit-loading .thinking { display: block; }
	</style>
	if len(p.Account) > 0 {
		<style>
			.portal-account { margin-left: auto; display: flex; gap: 1.25rem; }
			.portal-menu + .portal-account { margin-left: 0; }
		</style>
	}
	<nav class="portal-nav">
		for _, l := range p.Nav {
			<a key={ l.URL } href={ templ.SafeURL(l.URL) } class={ templ.KV("current", l.Current) }>{ l.Label }</a>
		}
		if len(p.Menu) > 0 {
			<details class="portal-menu">
				<summary>{ p.Portal }</summary>
				<div class="portal-menu-list">
					for _, l := range p.Menu {
						<a key={ l.URL } href={ templ.SafeURL(l.URL) }>{ l.Label }</a>
					}
				</div>
			</details>}
		if len(p.Account) > 0 {
			<span class="portal-account">
				for i, l := range p.Account {
					<span key={ strconv.Itoa(i) }>
						if l.URL != "" {
							<a href={ templ.URL(l.URL) }>{ l.Label }</a>
						} else {
							{ l.Label }
						}
					</span>
				}
			</span>
		}
	</nav>
	<main class="chat">
		<h1>{ p.Heading }</h1>
		<p class="note">Answers come from the API reference and the guides. Check the linked pages before you rely on an answer.</p>
		<ol id="messages" class="messages">
			for _, m := range p.Messages {
				<li key={ m.ID } class={ "message", templ.KV("mine", m.Mine), templ.KV("error", m.Error) }>
					@templ.Raw(m.HTML)
				</li>
			}
		</ol>
		<form id={ p.FormID() } class="ask-form" for={ live.For(lv, p.Form) } phx-submit={ p.Ask }>
			<p class="thinking">Looking it up...</p>
			<div class="ask">
				<textarea name="question" rows="3" aria-label="Your question" placeholder="Ask a question about the API" required></textarea>
				<button type="submit" phx-disable-with="Sending...">Send</button>
			</div>
		</form>
	</main>
}
